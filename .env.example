# Copy to .env at the repository root. Supply your own development secrets.
# Use URL-safe characters (for example hex) for database and RabbitMQ passwords.
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=

RABBITMQ_USER=bookstore
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=book_queue

MEILISEARCH_API_KEY=
JWT_SECRET=
SEED_DEFAULT_PASSWORD=

FRONTEND_PORT=3000
BACKEND_PORT=3001
# Browser-visible API URL; update when changing BACKEND_PORT or host name.
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
DEMO_SEED_ENABLED=true