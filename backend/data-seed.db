        FROM "Order" o
        JOIN "User" u
            ON o."userId" = u."id"
        WHERE u."email" = 'user2@example.com'
        ORDER BY o."id" DESC
        LIMIT 1
    ),
    (
        SELECT "id"
        FROM "Book"
        WHERE "isbn" = '9786040000003'
    ),
    350000.00,
    1,
    350000.00
),
(
    (
        SELECT o."id"
        FROM "Order" o
        JOIN "User" u
            ON o."userId" = u."id"
        WHERE u."email" = 'user2@example.com'
        ORDER BY o."id" DESC
        LIMIT 1
    ),
    (
        SELECT "id"
        FROM "Book"
        WHERE "isbn" = '9786040000004'
    ),
    180000.00,
    1,
    180000.00
);


