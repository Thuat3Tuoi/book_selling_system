
-- ============================================
-- BOOKSTORE DATABASE - SEED DATA
-- PostgreSQL + Prisma
-- ============================================

BEGIN;

TRUNCATE TABLE
    "Notification",
    "OrderItem",
    "Order",
    "CartItem",
    "Cart",
    "Book",
    "User",
    "Role"
RESTART IDENTITY CASCADE;

-- ============================================
-- 1. ROLE
-- ============================================

INSERT INTO "Role" (
    "roleName",
    "status"
)
VALUES
    ('ADMIN', TRUE),
    ('CUSTOMER', TRUE),
    ('STAFF', TRUE);


