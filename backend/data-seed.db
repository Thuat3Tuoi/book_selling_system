-- ============================================
-- 4. CART
-- ============================================

-- Tao gio hang cho 2 khach hang.

INSERT INTO "Cart" (
    "userId"
)
VALUES
(
    (
        SELECT "id"
        FROM "User"
        WHERE "email" = 'user1@example.com'
    )
),
(
    (
        SELECT "id"
        FROM "User"
        WHERE "email" = 'user2@example.com'
    )
);


-- ============================================
-- 5. CART ITEM
-- ============================================

-- Gio hang user1:
-- 1 Clean Code
-- 2 Atomic Habits

INSERT INTO "CartItem" (
    "cartId",
    "bookId",
    "quantity"
)
VALUES
(
    (
        SELECT c."id"
        FROM "Cart" c
        JOIN "User" u
            ON c."userId" = u."id"
        WHERE u."email" = 'user1@example.com'
    ),
    (
        SELECT "id"
        FROM "Book"
        WHERE "isbn" = '9786040000003'
    ),
    1
),
(
    (
        SELECT c."id"
        FROM "Cart" c
        JOIN "User" u
            ON c."userId" = u."id"
        WHERE u."email" = 'user1@example.com'
    ),
    (
        SELECT "id"
        FROM "Book"
        WHERE "isbn" = '9786040000004'
    ),
    2
);


-- Gio hang user2:
-- 1 Dac Nhan Tam

INSERT INTO "CartItem" (
    "cartId",
    "bookId",
    "quantity"
)
VALUES
(
    (
        SELECT c."id"
        FROM "Cart" c
        JOIN "User" u
            ON c."userId" = u."id"
        WHERE u."email" = 'user2@example.com'
    ),
    (
        SELECT "id"
        FROM "Book"
        WHERE "isbn" = '9786040000001'
    ),
    1
);


-- ============================================
-- 6. ORDER
-- ============================================

-- Don hang cua user1:
-- 2 Dac Nhan Tam = 240000
-- 1 Nha Gia Kim = 89000
-- Tong = 329000
-- Trang thai: COMPLETED

INSERT INTO "Order" (
    "userId",
    "totalAmount",
    "shippingAddress",
    "status"
)
VALUES
(
    (
        SELECT "id"
        FROM "User"
        WHERE "email" = 'user1@example.com'
    ),
    329000.00,
    '123 Nguyen Trai, Ha Noi',
    'COMPLETED'
);


-- Don hang cua user2:
-- 1 Clean Code = 350000
-- 1 Atomic Habits = 180000
-- Tong = 530000
-- Trang thai: PENDING

INSERT INTO "Order" (
    "userId",
    "totalAmount",
    "shippingAddress",
    "status"
)
VALUES
(
    (
        SELECT "id"
        FROM "User"
        WHERE "email" = 'user2@example.com'
    ),
    530000.00,
    '456 Le Loi, TP Ho Chi Minh',
    'PENDING'
);


-- ============================================
-- 7. ORDER ITEM
-- ============================================

-- Chi tiet don hang cua user1

INSERT INTO "OrderItem" (
    "orderId",
    "bookId",
    "unitPrice",
    "quantity",
    "totalPrice"
)
VALUES
(
    (
        SELECT o."id"
        FROM "Order" o
        JOIN "User" u
            ON o."userId" = u."id"
        WHERE u."email" = 'user1@example.com'
        ORDER BY o."id" DESC
        LIMIT 1
    ),
    (
        SELECT "id"
        FROM "Book"
        WHERE "isbn" = '9786040000001'
    ),
    120000.00,
    2,
    240000.00
),
(
    (
        SELECT o."id"
        FROM "Order" o
        JOIN "User" u
            ON o."userId" = u."id"
        WHERE u."email" = 'user1@example.com'
        ORDER BY o."id" DESC
        LIMIT 1
    ),
    (
        SELECT "id"
        FROM "Book"
        WHERE "isbn" = '9786040000002'
    ),
    89000.00,
    1,
    89000.00
);


-- Chi tiet don hang cua user2

INSERT INTO "OrderItem" (
    "orderId",
