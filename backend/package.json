    "type": "module",
    "scripts": {
        "prebuild": "prisma generate",
        "build": "nest build",
        "typecheck": "tsc --noEmit -p tsconfig.build.json",
        "format": "prettier . --write",
        "prisma:generate": "prisma generate",
        "prestart": "prisma generate",
        "start": "nest start",
        "prestart:dev": "prisma generate",
        "start:dev": "nest start --watch",
        "prestart:debug": "prisma generate",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "prelint": "prisma generate",
        "lint": "oxlint --type-aware src/ test/",
        "prisma:seed": "tsx prisma/seed.ts",
        "prisma:seed:safe": "tsx prisma/seed.safe.ts",
        "search:reindex": "tsx src/search/reindex.script.ts",
        "pretest": "prisma generate",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "pretest:e2e": "prisma generate",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
        "reindex": "node dist/search/reindex.script.js",
        "evidence": "node scripts/collect-evidence.mjs"
    },
    "dependencies": {
        "@keyv/redis": "^5.1.6",
        "@nestjs/cache-manager": "^12.0.0",
