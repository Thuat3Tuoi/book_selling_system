        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.2",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.9.8",
        "prisma": "7.10.1",
        "source-map-support": "^0.5.21",
