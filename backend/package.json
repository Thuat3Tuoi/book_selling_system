        "@nestjs/throttler": "^6.7.1",
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^2.2.0",
        "bcrypt": "^6.0.0",
        "cache-manager": "^7.2.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "ioredis": "^6.0.0",
        "keyv": "^5.6.0",
        "meilisearch": "^0.62.0",
