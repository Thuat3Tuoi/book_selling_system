    {
      "name": "07 - Đơn hàng",
      "description": "Tất cả route yêu cầu Bearer. Tạo đơn hàng ghi dữ liệu, trừ tồn kho, xóa mục giỏ hàng và phát sự kiện RabbitMQ; hãy chạy thủ công khi muốn tạo dữ liệu.",
      "item": [
        {
          "name": "POST /orders — Tạo đơn hàng",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "description": "Địa chỉ ít nhất 10 ký tự, orderItems không rỗng, bookId và quantity là số nguyên dương. Script lưu orderId và orderItemId đầu tiên.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Đường ABC, Phường 1, TP. Hồ Chí Minh\",\n  \"orderItems\": [\n    { \"bookId\": {{bookId}}, \"quantity\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data.id != null) pm.collectionVariables.set('orderId', String(data.id));",
                  "  if (data.orderItems && data.orderItems[0] && data.orderItems[0].id != null) {",
                  "    pm.collectionVariables.set('orderItemId', String(data.orderItems[0].id));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /orders — Danh sách đơn hàng",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders",
            "description": "Backend hiện trả tất cả đơn hàng sau khi xác thực, chưa lọc theo user."
          }
        },
        {
          "name": "GET /orders/:id — Chi tiết đơn hàng",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}",
            "description": "Lấy đơn hàng theo orderId; không tồn tại trả 404."
          }
        },
        {
          "name": "PATCH /orders/:id — Đổi địa chỉ",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
